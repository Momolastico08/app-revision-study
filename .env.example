# Supabase
# Récupérer dans : dashboard.supabase.com > Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️  SERVICE ROLE — bypasse RLS entièrement.
# Usage : scripts d'admin, seed, migrations côté serveur uniquement.
# Ne jamais inclure dans le bundle client (pas de préfixe EXPO_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=

# RevenueCat
# Récupérer dans : app.revenuecat.com > Project > API keys
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Anthropic
# Ne jamais mettre côté client. Configurer directement dans Supabase :
#   npx supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_API_KEY=
